# ── Stage 1: 构建 ──────────────────────────────────────────
FROM node:22 AS builder
WORKDIR /app

COPY package.json package-lock.json* ./
COPY scripts/ ./scripts/

RUN npm ci

# 只复制源码，跳过 host 的 node_modules（防止跨平台覆盖）
COPY tsconfig.json ./
COPY server/tsconfig.json ./server/
COPY server/ ./server/
COPY src/ ./src/
COPY shared/ ./shared/
COPY public/ ./public/
COPY index.html ./
COPY vite.config.js ./
COPY tailwind.config.js ./
COPY postcss.config.js ./
COPY eslint.config.js ./

RUN npm run build


# ── Stage 2: 运行环境 ──────────────────────────────────────
FROM node:22-slim
USER root

# 系统依赖（node-pty 需要编译工具）
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3 python3-setuptools git \
    && rm -rf /var/lib/apt/lists/*

# 安装 Claude Code CLI（全局）
RUN npm install -g @anthropic-ai/claude-code && claude --version

# 从 builder 复制产物
COPY --from=builder /app/node_modules    /app/node_modules
COPY --from=builder /app/package.json   /app/package.json
COPY --from=builder /app/dist           /app/dist
COPY --from=builder /app/dist-server    /app/dist-server
COPY --from=builder /app/shared         /app/shared
COPY --from=builder /app/public         /app/public
COPY --from=builder /app/scripts        /app/scripts

WORKDIR /app

# 修复 node-pty 原生绑定
RUN node scripts/fix-node-pty.js

# 统一权限
RUN chmod -R +x /app/node_modules/.bin/ && \
    chown -R node:node /app

USER node

EXPOSE 3001

# 直接指向编译后的入口文件
CMD ["node", "/app/dist-server/server/cli.js", "start", "--port", "3001"]
