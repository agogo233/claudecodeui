# Stage 1: 构建 CloudCLI
FROM node:22 AS builder
WORKDIR /app
# 拆开 COPY，避免 scripts/ 文件被展平到 /app/ 根目录
COPY package*.json ./
COPY scripts ./scripts/
RUN npm ci
COPY . .
RUN npm run build

# Stage 2: 运行环境
FROM node:22-slim
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3 python3-setuptools git \
    && rm -rf /var/lib/apt/lists/*

# 安装 Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code && claude --version

# 从 builder 复制运行时必需文件
COPY --from=builder /app/package.json /app/package.json
COPY --from=builder /app/dist /app/dist
COPY --from=builder /app/dist-server /app/dist-server
COPY --from=builder /app/shared /app/shared
COPY --from=builder /app/public /app/public
COPY --from=builder /app/scripts /app/scripts

WORKDIR /app
# --ignore-scripts 跳过 husky prepare；手动执行 fix-node-pty.js
RUN npm install --omit=dev --ignore-scripts && node scripts/fix-node-pty.js

EXPOSE 3001
USER node
CMD ["cloudcli", "start", "--port", "3001"]