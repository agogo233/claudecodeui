# ── Stage 1: 构建 ──────────────────────────────────────────
FROM node:22 AS builder
WORKDIR /app

COPY package.json ./
COPY scripts/ ./scripts/

RUN --mount=type=cache,target=/root/.npm \
    npm install

COPY tsconfig.json ./
COPY server/tsconfig.json ./server/
COPY server/ ./server/
COPY src/ ./src/
COPY shared/ ./shared/
COPY public/ ./public/
COPY index.html ./
COPY vite.config.js ./
COPY tailwind.config.js ./
COPY postcss.config.js ./
COPY eslint.config.js ./

RUN npm run build

# 优化: 移除 devDependencies（现在包含所有前端包）
RUN npm prune --omit=dev && \
    rm -rf node_modules/@anthropic-ai/claude-agent-sdk-linux-x64-musl


# ── Stage 2: 运行环境 ──────────────────────────────────────
FROM node:22-slim
USER root

# 仅安装运行时必需的系统包
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system core.quotepath false

# 创建 node 用户的可写目录
RUN mkdir -p /home/node/.local /home/node/.npm-global && \
    chown -R node:node /home/node/.local /home/node/.npm-global && \
    npm config set prefix /home/node/.npm-global -g

ENV PYTHONUSERBASE=/home/node/.local \
    PIP_USER=true \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PATH="/home/node/.local/bin:/home/node/.npm-global/bin:${PATH}"

# 安装 Claude Code CLI（以 root 安装，随后归还目录权限给 node 用户）
RUN npm install -g @anthropic-ai/claude-code && claude --version && \
    chown -R node:node /home/node/.npm-global

# 从 builder 复制产物（只复制运行时需要的）
COPY --from=builder /app/node_modules    /app/node_modules
COPY --from=builder /app/package.json   /app/package.json
COPY --from=builder /app/dist           /app/dist
COPY --from=builder /app/dist-server    /app/dist-server

WORKDIR /app
RUN chown -R node:node /app
USER node

EXPOSE 3001

CMD ["node", "/app/dist-server/server/cli.js", "start", "--port", "3001"]